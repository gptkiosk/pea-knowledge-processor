{
 "format": "pea-knowledge-topic-lexicon",
 "about": "What the keyword tagger looks for (src/pea_knowledge/topics.py). Per topic: phrases of one to four words by weight. 3 is a strong phrase, enough by itself in a title, notes or digest; 2 is a clear word; 1 is a weak word that only counts beside others. Plural and possessive endings are ignored. The longest phrase at a word wins. `blocked` phrases use a word in another sense: they take their words with them and count for nothing. Bare words that mean too many things (model, party) are either weak or not here at all.",
 "scoring": {
  "fields": {
   "title": 3,
   "notes": 2,
   "digest": 2,
   "transcript": 1
  },
  "transcript_chars": 30000,
  "notes_chars": 6000,
  "count_cap": 5,
  "half_score_at": 18,
  "min_score": 0.5,
  "relative_floor": 0.4,
  "max_topics": 4,
  "prior_bonus": 2,
  "strong_repeats_in_transcript": 3,
  "anchor_fields": [
   "title",
   "notes",
   "digest"
  ],
  "clear_repeats_in_transcript": 2,
  "weak_words_count_in": [
   "title",
   "notes"
  ]
 },
