{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pea-knowledge:v1:items",
  "title": "PEA knowledge items file (sources/<id>/items.json)",
  "description": "The items of one source, newest first, with the hash and size of every file. It has no time of its own, so it changes only when an item does.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "source_id",
    "items"
  ],
  "properties": {
    "format": {
      "const": "pea-knowledge-items"
    },
    "format_version": {
      "type": "string",
      "pattern": "^1\\.\\d{1,4}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "items": {
      "description": "Newest first.",
      "type": "array",
      "maxItems": 200,
      "items": {
        "description": "One item of a source.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "date",
          "link",
          "duration_seconds",
          "tags",
          "teaser",
          "stale",
          "stale_reason",
          "bytes",
          "digest",
          "transcript"
        ],
        "properties": {
          "id": {
            "description": "The item's id, unique within its source and stable across runs.",
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "title": {
            "description": "The item's title.",
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "date": {
            "description": "The day it was published.",
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
          },
          "link": {
            "description": "The publisher's page for this item: where to send the owner for the original.",
            "type": "string",
            "pattern": "^https://[a-z0-9.-]{4,253}/[\\x21-\\x7e]*$",
            "maxLength": 2000
          },
          "link_kind": {
            "description": "Since 1.1. What `link` leads to: \"episode\" is the publisher's page for this one item; \"show\" means the publisher gives no page per item, so the link is the show's site. Absent in a 1.0 file: treat as \"episode\".",
            "type": "string",
            "enum": [
              "episode",
              "show"
            ]
          },
          "duration_seconds": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 359999,
            "description": "Its length, or null."
          },
          "tags": {
            "description": "The publisher's tags.",
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,23}$"
            },
            "uniqueItems": true
          },
          "teaser": {
            "description": "One or two sentences, so the assistant can propose the item without opening its digest.",
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "stale": {
            "description": "True when the last attempt to refresh this item failed and the files are from an earlier run.",
            "type": "boolean"
          },
          "stale_reason": {
            "description": "Why, when stale.",
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "fetch_failed",
              "unreadable"
            ]
          },
          "bytes": {
            "description": "The size of the item's files together.",
            "type": "integer",
            "minimum": 1,
            "maximum": 2000000
          },
          "digest": {
            "description": "The item's digest file, and what kind of digest it is (repeated from the file so a reader can choose without opening it).",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "bytes",
              "basis",
              "grade",
              "method"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^sources/[a-z0-9][a-z0-9-]{0,63}/[a-z0-9][a-z0-9-]{0,63}\\.digest\\.json$",
                "maxLength": 200
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 24000
              },
              "basis": {
                "type": "string",
                "enum": [
                  "transcript",
                  "notes",
                  "headline"
                ]
              },
              "grade": {
                "type": "string",
                "enum": [
                  "full",
                  "partial",
                  "headline"
                ]
              },
              "method": {
                "type": "string",
                "enum": [
                  "extractive",
                  "model"
                ]
              }
            }
          },
          "transcript": {
            "description": "The item's transcript (PEA transcript v1), when the output carries one.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "available",
              "reason",
              "file"
            ],
            "properties": {
              "available": {
                "description": "Whether a transcript file is in the output: all of it, its first part, or none.",
                "type": "string",
                "enum": [
                  "yes",
                  "partial",
                  "no"
                ]
              },
              "reason": {
                "description": "Null for yes; \"cut\" for partial; for no, why there is none.",
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  null,
                  "none_published",
                  "fetch_failed",
                  "unreadable",
                  "cut",
                  "withheld_terms"
                ]
              },
              "file": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "sha256",
                      "bytes"
                    ],
                    "properties": {
                      "path": {
                        "description": "Where the file is, relative to the folder store.json is in. Never absolute, never with \"..\".",
                        "type": "string",
                        "pattern": "^sources/[a-z0-9][a-z0-9-]{0,63}/[a-z0-9][a-z0-9-]{0,63}\\.transcript\\.pea\\.txt$",
                        "maxLength": 200
                      },
                      "sha256": {
                        "description": "SHA-256 of the file's bytes, lower-case hexadecimal.",
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "bytes": {
                        "description": "The file's size in bytes.",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000000
                      }
                    }
                  }
                ]
              },
              "read": {
                "description": "Since 1.1. What the pipeline read at the publisher to make the digest, whether or not the file is published: a full transcript, a cut one, or none.",
                "type": "string",
                "enum": [
                  "full",
                  "partial",
                  "none"
                ]
              }
            }
          },
          "transcript_source": {
            "description": "Since 1.1 (added 2026-11-15). Where the publisher itself offers this item's transcript, for a reader that wants the whole text: it fetches the address itself, from the publisher, and normalizes it on the device. Present only when the pipeline read a transcript there without signing in. Absent when none is offered.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "link",
              "format",
              "route",
              "bytes"
            ],
            "properties": {
              "link": {
                "description": "The publisher's own public address of the transcript. Named `link` because `site` and `link` are the only members that may hold an address.",
                "type": "string",
                "pattern": "^https://[a-z0-9.-]{4,253}/[\\x21-\\x7e]*$",
                "maxLength": 2000
              },
              "format": {
                "description": "What is at the address: WebVTT, SubRip, Podcasting 2.0 JSON, plain text, markdown, or an HTML page (read with `extract`).",
                "type": "string",
                "enum": [
                  "vtt",
                  "srt",
                  "json",
                  "text",
                  "markdown",
                  "html"
                ]
              },
              "route": {
                "description": "How the address was found: \"feed_tag\" (the publisher's feed or index lists it for this item), \"notes_link\" (the item's notes link to it), \"page\" (it follows from the item's page).",
                "type": "string",
                "enum": [
                  "feed_tag",
                  "notes_link",
                  "page"
                ]
              },
              "bytes": {
                "description": "The size of what the pipeline read there, after decompression, or null when not known. A hint, not a promise.",
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 1500000
              },
              "extract": {
                "description": "Only with format html: Which elements of the page hold the transcript, as lists of simple selectors: \"tag\", \".class\", \"#id\", \"tag.class\" or \"tag#id\". Data, never code.",
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {
                  "within": {
                    "description": "The elements that hold the transcript. Without it: the element whose id or class says \"transcript\".",
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^(?:[a-z][a-z0-9]{0,15})?(?:[.#][A-Za-z0-9_-]{1,60})?$"
                    }
                  },
                  "drop": {
                    "description": "Elements left out, beyond what is always left out (scripts, menus, headings, hidden text).",
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^(?:[a-z][a-z0-9]{0,15})?(?:[.#][A-Za-z0-9_-]{1,60})?$"
                    }
                  },
                  "row": {
                    "description": "The element of one turn: one speaker, one time, their text.",
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^(?:[a-z][a-z0-9]{0,15})?(?:[.#][A-Za-z0-9_-]{1,60})?$"
                    }
                  },
                  "speaker": {
                    "description": "The elements whose text is the speaker's name. Without it and without row: cite and dt.",
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^(?:[a-z][a-z0-9]{0,15})?(?:[.#][A-Za-z0-9_-]{1,60})?$"
                    }
                  },
                  "time": {
                    "description": "The elements whose text holds the time of what follows. Without it and without row: time.",
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^(?:[a-z][a-z0-9]{0,15})?(?:[.#][A-Za-z0-9_-]{1,60})?$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
