{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pea-knowledge:v1:sources",
  "title": "The curated source list (config/sources.json)",
  "description": "Which sources the pipeline reads, what may be published from each, and the limits of a run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "sources"
  ],
  "properties": {
    "format": {
      "const": "pea-knowledge-sources"
    },
    "format_version": {
      "type": "string",
      "pattern": "^1\\.\\d{1,4}$"
    },
    "min_app_version": {
      "description": "The oldest app version that should read this output, or null. An older app keeps what it has and asks for an update.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{1,4}\\.\\d{1,4}(\\.\\d{1,4})?$"
    },
    "defaults": {
      "description": "Limits that apply to every source unless it says otherwise.",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "auto_pause_after_failed_runs": {
          "description": "A source that cannot be read this many runs in a row is paused.",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "tombstone_days": {
          "description": "How long a withdrawn source stays listed, so that apps learn of it.",
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "excerpt_budget_chars": {
          "description": "For digest_only sources: the most characters a digest may take from the transcript.",
          "type": "integer",
          "minimum": 500,
          "maximum": 20000
        },
        "suggested_keep": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "max_total_bytes": {
          "description": "The run fails rather than publish more than this.",
          "type": "integer",
          "minimum": 100000,
          "maximum": 900000000
        },
        "min_full_transcript_share": {
          "description": "The rule of the catalog: an item is offered only when the assistant has a full path to its whole text (it is discussable), and a source only when enough of its newest items are. Of the newest `transcript_check_items`, at least this share must be discussable (and at least `min_discussable_items`); otherwise the source is counted as failed, so paused, then withdrawn. 0 together with `min_discussable_items` 0 switches the check off.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_discussable_items": {
          "description": "The fewest discussable items among the newest `transcript_check_items` that a source may have (default 2).",
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "transcript_check_items": {
          "description": "How many of the newest items the rule looks at.",
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "withdraw_without_transcripts_days": {
          "description": "A source paused for want of full transcripts is withdrawn after this many days.",
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "phone_probe": {
          "description": "Probe the newest discussable item of each source the way the phone fetches it (default true).",
          "type": "boolean"
        },
        "phone_probe_reuse_hours": {
          "description": "An ok probe result is reused for this many hours while the item is unchanged (default 24).",
          "type": "integer",
          "minimum": 0,
          "maximum": 720
        },
        "only_discussable_items": {
          "description": "The item rule: only items the assistant has a full path to (transcript read in full or part, and a `transcript_source`) are listed. Default true; only the tests of thin items switch it off.",
          "type": "boolean"
        }
      }
    },
    "model": {
      "description": "The optional model digest.",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "model": {
          "description": "The model id at the server.",
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "base_url": {
          "type": "string",
          "maxLength": 200
        },
        "max_input_chars": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 400000
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 200,
          "maximum": 8000
        },
        "max_notes_chars": {
          "description": "How much of an item's show notes the model is shown beside the transcript.",
          "type": "integer",
          "minimum": 0,
          "maximum": 20000
        },
        "max_items_per_run": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "max_cost_usd_per_item": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "max_cost_usd_per_run": {
          "type": "number",
          "minimum": 0,
          "maximum": 50
        },
        "price_per_million_input_usd": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "price_per_million_output_usd": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "topics": {
          "description": "True: the model that writes a digest may also propose the item's topics, from the vocabulary only. Off by default; the keyword tagger is used whenever the model's answer does not hold up.",
          "type": "boolean"
        }
      }
    },
    "sources": {
      "description": "The sources, in the order the store shows them.",
      "type": "array",
      "maxItems": 100,
      "items": {
        "description": "One curated source.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "adapter",
          "url",
          "site",
          "publisher",
          "language",
          "description",
          "overview",
          "categories",
          "icon",
          "publish",
          "attribution",
          "terms"
        ],
        "properties": {
          "id": {
            "description": "The source's id: stable for as long as the source exists, safe in a path.",
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "name": {
            "description": "The source's name, for the store card.",
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "kind": {
            "description": "\"podcast\": spoken episodes. \"news\": articles, as headline, short description and link only.",
            "type": "string",
            "enum": [
              "podcast",
              "news"
            ]
          },
          "adapter": {
            "description": "How the address is read.",
            "type": "string",
            "enum": [
              "agent_index",
              "feed",
              "json_feed"
            ]
          },
          "url": {
            "description": "The index or feed to read.",
            "type": "string",
            "pattern": "^https://[a-z0-9.-]{4,253}/[\\x21-\\x7e]*$",
            "maxLength": 400
          },
          "site": {
            "description": "The publisher's site. One of the two kinds of address the format allows.",
            "type": "string",
            "pattern": "^https://[a-z0-9.-]{4,253}/[\\x21-\\x7e]*$",
            "maxLength": 400
          },
          "publisher": {
            "description": "Who publishes the source.",
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "language": {
            "description": "The language of the items (BCP 47).",
            "type": "string",
            "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{1,8})*$"
          },
          "description": {
            "description": "One or two sentences for the store card: what the owner gets.",
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "overview": {
            "description": "What the source is, its beat and voice, and how an item is usually built. For the assistant, so she can talk about the source itself.",
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "categories": {
            "description": "Topic tags for browsing and filtering.",
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,23}$"
            },
            "uniqueItems": true
          },
          "icon": {
            "description": "A hint for drawing the card: a symbol name and a colour name from fixed lists. The format carries no images.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "symbol",
              "colour"
            ],
            "properties": {
              "symbol": {
                "type": "string",
                "enum": [
                  "microphone",
                  "newspaper",
                  "waveform",
                  "book",
                  "globe",
                  "chip",
                  "briefcase",
                  "sparkles",
                  "shield",
                  "leaf",
                  "chart",
                  "people"
                ]
              },
              "colour": {
                "type": "string",
                "enum": [
                  "blue",
                  "green",
                  "orange",
                  "purple",
                  "red",
                  "teal",
                  "grey",
                  "yellow",
                  "pink",
                  "indigo"
                ]
              }
            }
          },
          "publish": {
            "description": "\"full\": transcripts are in the output. \"digest_only\": only digests are; the terms do not clearly allow more.",
            "type": "string",
            "enum": [
              "full",
              "digest_only"
            ]
          },
          "attribution": {
            "description": "The credit line to show with anything taken from this source.",
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "suggested_keep": {
            "description": "How many items the curator suggests keeping on the device. Only a suggestion: the owner decides.",
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "max_items": {
            "description": "How many of the newest items are kept. Overrides the default.",
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "retention_days": {
            "description": "Items older than this are dropped. Overrides the default.",
            "type": "integer",
            "minimum": 1,
            "maximum": 3650
          },
          "min_full_transcript_share": {
            "description": "Overrides the default share of newest items that must be discussable.",
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "min_discussable_items": {
            "description": "Overrides the default.",
            "type": "integer",
            "minimum": 0,
            "maximum": 50
          },
          "phone_probe": {
            "description": "Overrides the default.",
            "type": "boolean"
          },
          "transcript_check_items": {
            "description": "Overrides the default.",
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "state": {
            "description": "A manual lifecycle state. It always wins over what the pipeline would decide. Leave it out for automatic.",
            "type": "string",
            "enum": [
              "active",
              "paused",
              "withdrawn"
            ]
          },
          "state_reason": {
            "description": "Why, for a manual paused or withdrawn state.",
            "type": "string",
            "enum": [
              "manual",
              "licence",
              "takedown",
              "quality"
            ]
          },
          "message": {
            "description": "The sentence the owner sees for a manual state. Text only.",
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "purge": {
            "description": "With state withdrawn: apps must delete their local copy.",
            "type": "boolean"
          },
          "terms": {
            "description": "What was verified about the publisher's terms, and when.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "checked",
              "robots",
              "licence",
              "terms_of_use",
              "summary",
              "uncertain"
            ],
            "properties": {
              "checked": {
                "description": "The day the terms were read.",
                "type": "string",
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
              },
              "robots": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "url",
                  "finding"
                ],
                "properties": {
                  "url": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 400
                  },
                  "finding": {
                    "description": "What was found there.",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  }
                }
              },
              "licence": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "url",
                  "finding"
                ],
                "properties": {
                  "url": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 400
                  },
                  "finding": {
                    "description": "What was found there.",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  }
                }
              },
              "terms_of_use": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "url",
                  "finding"
                ],
                "properties": {
                  "url": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 400
                  },
                  "finding": {
                    "description": "What was found there.",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  }
                }
              },
              "summary": {
                "description": "What the publisher's terms were found to allow, in one or two sentences.",
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "uncertain": {
                "description": "What could not be settled.",
                "type": "array",
                "maxItems": 10,
                "items": {
                  "description": "Something the owner should decide or check.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                }
              }
            }
          },
          "transcript_route": {
            "description": "For the curator: where the publisher offers the full transcript and in what form.",
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "chosen_because": {
            "description": "For the curator: why this source is in the catalog.",
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "hosts": {
            "description": "The show's regular hosts, so that a host is never listed as a guest of an item.",
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "transcript_page": {
            "description": "For a publisher whose full transcript is an open HTML page on its own site: how the page of an episode is found, and how it is read.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "host"
            ],
            "properties": {
              "from": {
                "description": "\"link\": the item's own page holds the transcript. \"notes_link\": the item's notes link to it. \"page_link\": the item's page links to it. \"template\": the address follows from the last part of the item's page address.",
                "type": "string",
                "enum": [
                  "link",
                  "notes_link",
                  "page_link",
                  "template"
                ]
              },
              "host": {
                "description": "The one host a transcript page may be on.",
                "type": "string",
                "pattern": "^[a-z0-9.-]{4,253}$"
              },
              "path_ends": {
                "description": "For notes_link and page_link: how the path of the transcript page ends (a final slash aside). Without it, the link must be labelled Transcript.",
                "type": "string",
                "pattern": "^[A-Za-z0-9/._-]{1,60}$"
              },
              "template": {
                "description": "For template: the address, with {slug} where the last part of the item's page address goes.",
                "type": "string",
                "pattern": "^https://[a-z0-9.-]{4,253}/[\\x21-\\x7e]*$",
                "maxLength": 400
              },
              "min_chars": {
                "description": "A page with less transcript text than this is not a transcript. Default 1500.",
                "type": "integer",
                "minimum": 200,
                "maximum": 100000
              },
              "extract": {
                "description": "Which elements of the page hold the transcript, as lists of simple selectors: \"tag\", \".class\", \"#id\", \"tag.class\" or \"tag#id\". Data, never code.",
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {
                  "within": {
                    "description": "The elements that hold the transcript. Without it: the element whose id or class says \"transcript\".",
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^(?:[a-z][a-z0-9]{0,15})?(?:[.#][A-Za-z0-9_-]{1,60})?$"
                    }
                  },
                  "drop": {
                    "description": "Elements left out, beyond what is always left out (scripts, menus, headings, hidden text).",
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^(?:[a-z][a-z0-9]{0,15})?(?:[.#][A-Za-z0-9_-]{1,60})?$"
                    }
                  },
                  "row": {
                    "description": "The element of one turn: one speaker, one time, their text.",
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^(?:[a-z][a-z0-9]{0,15})?(?:[.#][A-Za-z0-9_-]{1,60})?$"
                    }
                  },
                  "speaker": {
                    "description": "The elements whose text is the speaker's name. Without it and without row: cite and dt.",
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^(?:[a-z][a-z0-9]{0,15})?(?:[.#][A-Za-z0-9_-]{1,60})?$"
                    }
                  },
                  "time": {
                    "description": "The elements whose text holds the time of what follows. Without it and without row: time.",
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^(?:[a-z][a-z0-9]{0,15})?(?:[.#][A-Za-z0-9_-]{1,60})?$"
                    }
                  }
                }
              }
            }
          },
          "topics": {
            "description": "The source's overall beat: up to six ids of config/topics.json, most typical first.",
            "type": "array",
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
            }
          },
          "brief_writer": {
            "description": "model (the default): a model may write this source's briefs. extractive: never send this source to a model; set it when the source's terms forbid quotes or derived summaries.",
            "type": "string",
            "enum": [
              "model",
              "extractive"
            ]
          }
        }
      }
    },
    "topics": {
      "description": "Topic tagging (docs/FORMAT.md, \"Topics\"). On unless switched off here.",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "enabled": {
          "description": "False: the output carries no vocabulary and no topics.",
          "type": "boolean"
        }
      }
    },
    "briefs": {
      "description": "Format 1.3 briefs. Extractive briefs are always made; model briefs only when enabled and a key is given.",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "base_url": {
          "type": "string",
          "maxLength": 200
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 500,
          "maximum": 16000
        },
        "chunk_chars": {
          "description": "A transcript longer than this is written in parts and merged.",
          "type": "integer",
          "minimum": 5000,
          "maximum": 400000
        },
        "max_chunks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "max_calls_per_run": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "upgrade_per_run": {
          "description": "How many listed items with an extractive brief may be fetched again per run to get a model brief.",
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "price_per_million_input_usd": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "price_per_million_output_usd": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "brief_budget": {
      "description": "Caps on what model briefs may cost, in US cents. The month's spend is kept in state.json.",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "monthly_cents": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "per_run_cents": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        }
      }
    }
  }
}
