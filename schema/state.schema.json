{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pea-knowledge:v1:state",
  "title": "Pipeline memory (state.json)",
  "description": "What the pipeline remembers between runs. Not part of the format an app reads: an app MUST NOT fetch or use it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "sources"
  ],
  "properties": {
    "format": {
      "const": "pea-knowledge-state"
    },
    "format_version": {
      "type": "string",
      "pattern": "^1\\.\\d{1,4}$"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "etag",
          "last_modified",
          "fingerprint",
          "items"
        ],
        "properties": {
          "etag": {
            "type": "string",
            "maxLength": 200
          },
          "last_modified": {
            "type": "string",
            "maxLength": 60
          },
          "fingerprint": {
            "type": "string",
            "maxLength": 200
          },
          "items": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "method"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "method": {
                  "type": "string",
                  "enum": [
                    "extractive",
                    "model"
                  ]
                }
              }
            }
          },
          "config": {
            "description": "A hash of the source's settings: when they change, the feed is read again in full.",
            "type": "string",
            "maxLength": 64
          }
        }
      }
    }
  }
}
